{
  "version": "2.0",
  "domains": {
    "users": ["list", "current", "upsert", "setCoins", "setVip", "setRole", "block", "restore"],
    "library": ["list", "upsert", "stats"],
    "progress": ["list", "save"],
    "chapters": ["list", "byManhwa", "saveBatch", "upsert", "delete"],
    "media": ["list", "put"],
    "catalog": ["list", "find"]
  },
  "remoteEndpoints": {
    "GET /users": "list users",
    "POST /users": "upsert user",
    "PATCH /users": "coins/vip/role/block/restore",
    "GET /library?uid=": "library list",
    "POST /library": "upsert library item",
    "GET /library/stats?uid=": "library stats",
    "GET /progress?uid=": "reading progress list",
    "POST /progress": "save reading progress",
    "GET /chapters": "chapter list",
    "POST /chapters": "save batch chapters",
    "POST /chapters/patch": "patch one chapter",
    "POST /chapters/delete": "delete chapter",
    "GET /media": "media list",
    "POST /media": "store media metadata/upload result",
    "GET /catalog": "catalog list"
  }
}
